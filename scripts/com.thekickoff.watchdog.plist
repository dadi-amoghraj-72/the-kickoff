<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The backup for GitHub: every day at 8:30am (this Mac's clock: set to Singapore time) checks that the day's page is live; if not, builds the edition here and sends it to Telegram.
     Does nothing when the page is live. The Mac must be awake: to wake it at 8:25 run once (needs your password):  sudo pmset repeat wakeorpoweron MTWRFSU 08:25:00
     Switch on:   mkdir -p ~/Documents/the-kickoff/preview && cp ~/Documents/the-kickoff/scripts/com.thekickoff.watchdog.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.thekickoff.watchdog.plist
     Switch off:  launchctl bootout gui/$(id -u)/com.thekickoff.watchdog && rm ~/Library/LaunchAgents/com.thekickoff.watchdog.plist
     Log: ~/Documents/the-kickoff/preview/watchdog.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.thekickoff.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dadiamoghraj/Documents/the-kickoff/.venv/bin/python</string>
    <string>/Users/dadiamoghraj/Documents/the-kickoff/scripts/watchdog.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/dadiamoghraj/Documents/the-kickoff</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/dadiamoghraj/Documents/the-kickoff/preview/watchdog.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/dadiamoghraj/Documents/the-kickoff/preview/watchdog.launchd.log</string>
</dict>
</plist>
